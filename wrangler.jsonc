{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mitm-server",
	"main": "worker.js",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public"
	},
	"d1_databases": [
		{
			"binding": "random_access_memory",
			"database_name": "random-access-memory",
			"database_id": "337df48c-398f-43d0-8c3e-ed2ad1e0ffb6"
		}
	]
}