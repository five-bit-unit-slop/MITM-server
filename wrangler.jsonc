{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mitm-server",
    "main": "worker.js",
    "compatibility_date": "2026-11-16",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": "./public"
    },
    "vars": {
        "AZURE_DB_BRIDGE_URL": "https://smartsystem-db-bridge-dxfhcce6dvesf4dj.swedencentral-01.azurewebsites.net/api/database" //behind a whitelist so don't even try! >:(
    },
    "ratelimits": [
        {
            "name": "API_RATE_LIMITER",
            "namespace_id": "739201",
            "simple": {
                "limit": 60,
                "period": 60
            }
        }
    ]
}
