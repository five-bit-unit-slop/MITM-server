{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mitm-server",
    "main": "worker.js",
    "compatibility_date": "2026-11-16",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": "./public"
    },
    "vars": {
        "_Comment": "behind a whitelist so don't even try! >:(",
        "AZURE_DB_BRIDGE_URL": "https://smartsystem-db-bridge-dxfhcce6dvesf4dj.swedencentral-01.azurewebsites.net"
    },
    "ratelimits": [
        {
            "name": "API_RATE_LIMITER",
            "namespace_id": "739201",
            "simple": {
                "limit": 60,
                "period": 60
            }
        }
    ],
    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true
        },
        "issues": {
            "enabled": true
        }
    },
    "previews": {
        "vars": {
            "AZURE_DB_BRIDGE_URL": "https://smartsystem-db-bridge-dxfhcce6dvesf4dj.swedencentral-01.azurewebsites.net"
        },
        "ratelimits": [
            {
                "name": "API_RATE_LIMITER",
                "namespace_id": "739202",
                "simple": {
                    "limit": 60,
                    "period": 60
                }
            }
        ]
    }
}